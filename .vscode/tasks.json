{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TypeScript: Watch",
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "option": "watch",
      "problemMatcher": ["$tsc-watch"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "ESLint: Lint All Files",
      "type": "shell",
      "command": "npx",
      "args": ["eslint", "src/**/*.{ts,tsx}", "--ext", ".ts,.tsx"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$eslint-stylish"],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "TypeScript: Check All Files",
      "type": "shell",
      "command": "npx",
      "args": ["tsc", "--noEmit", "--pretty"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}

